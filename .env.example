# Pooled connection (app queries) via the -pooler hostname
DATABASE_URL='postgresql://user:password@ep-xxx-pooler.aws.neon.tech/neondb?sslmode=verify-full'

# Direct connection (migrations, seed), no -pooler suffix
DATABASE_URL_UNPOOLED='postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=verify-full'

# Absolute base URL for share images
NEXT_PUBLIC_SITE_URL='http://localhost:3000'

# Shared passcode for /studio
STUDIO_PASSCODE='change-me-to-a-long-random-string'
